{
  "name": "ecommerce-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open --port 4211",
    "start:en": "ng serve --open --port 4211 --configuration=en",
    "start:ja": "ng serve --open --port 4211 --configuration=ja",
    "sync-xlf": "node sync-xlf.js",
    "build": "ng build --localize --configuration development",
    "build:prod": "ng build --localize --configuration production",
    "start:ssr": "node ./dist/ecommerce-angular/server/vi/server.mjs",
    "start:ssr:en": "node ./dist/ecommerce-angular/server/en/server.mjs",
    "start:ssr:ja": "node ./dist/ecommerce-angular/server/ja/server.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.2",
    "@angular/cdk": "^20.0.2",
    "@angular/common": "^20.0.2",
    "@angular/compiler": "^20.0.2",
    "@angular/core": "^20.0.2",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.0.2",
    "@angular/localize": "^20.2.1",
    "@angular/material": "^20.0.2",
    "@angular/platform-browser": "^20.0.2",
    "@angular/platform-browser-dynamic": "^20.0.2",
    "@angular/platform-server": "^20.0.2",
    "@angular/router": "^20.0.2",
    "@angular/ssr": "^20.0.1",
    "@angular/youtube-player": "^20.0.2",
    "@daelmaak/ngx-gallery": "^3.1.1",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@xmldom/xmldom": "^0.8.11",
    "chalk": "^4.1.2",
    "express": "^4.18.2",
    "firebase": "^11.9.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "ngx-editor": "^17.5.4",
    "ngx-mask": "^20.0.3",
    "ngx-owl-carousel-o": "^20.0.1",
    "ngx-toastr": "^19.0.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.4.0",
    "xml-formatter": "^3.6.6",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.1",
    "@angular/cli": "^20.0.1",
    "@angular/compiler-cli": "^20.0.2",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^18.18.0",
    "angular-eslint": "20.2.0",
    "eslint": "^9.33.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.40.0"
  }
}